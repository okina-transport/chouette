            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>mobi.chouette.exchange.converter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>mobi.chouette.service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>mobi.chouette.ws</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>mobi.chouette.exchange.mapmatching</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.okina</groupId>
                <artifactId>netex-java-model</artifactId>
                <version>${netex-java-model.version}</version>
            </dependency>

            <dependency>
                <groupId>com.okina.helpers</groupId>
                <artifactId>calendar-helper</artifactId>
                <version>${okina-helpers.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-databind</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
